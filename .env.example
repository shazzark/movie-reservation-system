# Local replica-set example. For MongoDB Atlas, use your cluster URI instead.
DATABASE_URL=mongodb://127.0.0.1:27017/cinebook?replicaSet=rs0

# Replace with a long random value before running the app.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional Cloudinary credentials for admin poster uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for TMDB import; manual movie creation works without it.
# Use the API Read Access Token from TMDB account API settings, not the API key.
# Server-only: set in .env.local and restart Next.js. Never use NEXT_PUBLIC_.
TMDB_API_TOKEN=
